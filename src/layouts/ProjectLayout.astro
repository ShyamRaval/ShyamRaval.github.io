---
/**
 * ProjectLayout — case-study chrome around rendered MDX.
 *
 * The page (`projects/[slug].astro`) renders the MDX body into the
 * default slot; this layout supplies the title, summary, tags, links,
 * lead image, and a quiet "back to work" return path.
 */
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Media from "../components/Media.astro";
import { type Accent, chipClass } from "../lib/accents";
import { thumbnailId, yearOf } from "../lib/content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, summary, tags, links } = entry.data;
const accent: Accent = entry.data.accent ?? "coral";
const year = yearOf(entry.data.publishedAt);
---
<BaseLayout title={title} description={summary}>
  <article class="container-prose section">
    <a href="/projects" class="font-hand text-lg ink-lavender link-underline">
      &larr; back to the work
    </a>

    <header class="mt-5">
      <p class="font-hand text-xl ink-coral">{year}</p>
      <h1 class="mt-1">{title}</h1>
      <p class="mt-4 text-lg text-[color:var(--color-ink-soft)] leading-relaxed">
        {summary}
      </p>

      {tags?.length ? (
        <ul class="mt-4 flex flex-wrap gap-1.5 list-none p-0">
          {tags.map((tag) => (
            <li class:list={["chip", chipClass(accent)]}>{tag}</li>
          ))}
        </ul>
      ) : null}

      {(links?.live || links?.github) && (
        <div class="mt-4 flex flex-wrap gap-4 font-hand text-lg">
          {links?.live && (
            <a href={links.live} target="_blank" rel="noreferrer noopener" class="ink-sky link-underline">
              visit it live &nearr;
            </a>
          )}
          {links?.github && (
            <a href={links.github} target="_blank" rel="noreferrer noopener" class="ink-mint link-underline">
              read the code &nearr;
            </a>
          )}
        </div>
      )}
    </header>

    <figure class="mt-8 mb-2 overflow-hidden rounded-[var(--radius-card)] border border-[color:var(--color-edge)]">
      <Media
        id={thumbnailId(entry)}
        alt={`${title} — lead image`}
        width={896}
        height={504}
        loading="eager"
        sizes="(min-width: 768px) 1152px, 100vw"
        class="block w-full object-cover"
      />
    </figure>

    <div class="prose mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
