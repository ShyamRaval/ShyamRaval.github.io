---
import type { CollectionEntry } from "astro:content";
import Media from "./Media.astro";
import { type Accent, chipClass } from "../lib/accents";
import { coverId, formatDate } from "../lib/content";

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { title, description, tags } = entry.data;
const accent: Accent = entry.data.accent ?? "lavender";
const href = `/blog/${entry.id}`;
const date = formatDate(entry.data.publishedAt);
---
<article class="card-quiet overflow-hidden self-start group">
  <a href={href} class="block focus:outline-none">
    <div class="aspect-[16/9] overflow-hidden border-b border-[color:var(--color-edge)] bg-[color:var(--color-surface-muted)]">
      <Media
        id={coverId(entry)}
        alt={`${title} — cover`}
        width={640}
        height={360}
        sizes="(min-width: 768px) 480px, 100vw"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="p-5">
      <p class="font-hand text-base text-[color:var(--color-ink-muted)]">{date}</p>
      <h3 class={`mt-0.5 font-display text-xl md:text-2xl leading-tight transition-colors group-hover:text-[color:var(--color-pastel-${accent}-deep)]`}>
        {title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed">{description}</p>

      {tags?.length ? (
        <ul class="mt-3 flex flex-wrap gap-1.5 list-none p-0">
          {tags.map((tag) => (
            <li class:list={["chip", chipClass(accent)]}>{tag}</li>
          ))}
        </ul>
      ) : null}
    </div>
  </a>
</article>
