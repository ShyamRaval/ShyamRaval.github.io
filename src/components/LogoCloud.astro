---
import { techLogos } from "../data/tech-logos";

const accentChip: Record<string, string> = {
  sky:      "chip-sky",
  coral:    "chip-coral",
  mint:     "chip-mint",
  butter:   "chip-butter",
  lavender: "chip-lavender",
  rose:     "chip-rose",
};
---
<ul class="flex flex-wrap gap-1.5 reveal-stagger">
  {techLogos.map((logo) => {
    const className = accentChip[logo.accent ?? "sky"] ?? "chip-sky";
    const inner = <span class:list={["chip", className]}>{logo.name}</span>;
    return (
      <li>
        {logo.href ? (
          <a
            href={logo.href}
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex"
          >
            {inner}
          </a>
        ) : (
          inner
        )}
      </li>
    );
  })}
</ul>
