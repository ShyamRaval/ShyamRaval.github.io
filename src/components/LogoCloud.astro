---
import { techLogos } from "../data/tech-logos";
import { chipClass, toAccent } from "../lib/accents";
---
<ul class="flex flex-wrap gap-1.5 reveal-stagger">
  {techLogos.map((logo) => {
    const accent = toAccent(logo.accent, "sky");
    const inner = <span class:list={["chip", chipClass(accent)]}>{logo.name}</span>;
    return (
      <li>
        {logo.href ? (
          <a
            href={logo.href}
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex"
          >
            {inner}
          </a>
        ) : (
          inner
        )}
      </li>
    );
  })}
</ul>
