---
/**
 * Header — a thin strip carrying a single handwritten "marginalia" line.
 *
 * Per PLAN.md (2026-05-27): no name, no logo, no nav. Just one short line
 * picked at random from `src/data/marginalia.ts`.
 *
 * Rolling policy:
 *   - Every page load (refresh) re-rolls.
 *   - In-app navigation keeps the current line because the header is persisted.
 *   - No sessionStorage / no per-session pinning — that was the previous
 *     bug, which made each device feel like it "owned" one statement.
 *
 * This is a static site, so Astro cannot produce new server HTML on each
 * GitHub Pages refresh. The inline script writes the line while the browser is
 * still parsing this paragraph, avoiding a visible render-then-replace step.
 */
import { marginalia } from "../data/marginalia";
---
<header
  class="container-page py-3 md:py-4 text-center"
  transition:persist
>
  <p
    id="page-marginalia"
    class="font-hand text-base md:text-lg text-[color:var(--color-ink-soft)] m-0 leading-snug"
    aria-live="off"
  >
    <script is:inline define:vars={{ lines: marginalia }}>
      (function () {
        var line = lines[Math.floor(Math.random() * lines.length)];
        var escaped = String(line)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");

        document.write("&mdash; " + escaped + " &mdash;");
      })();
    </script>
    <noscript>&mdash; {marginalia[0]} &mdash;</noscript>
  </p>
</header>
