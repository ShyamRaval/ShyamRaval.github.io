---
import type { CollectionEntry } from "astro:content";
import Media from "./Media.astro";
import { type Accent, chipClass } from "../lib/accents";
import { thumbnailId, yearOf } from "../lib/content";

interface Props {
  entry: CollectionEntry<"projects">;
  size?: "compact" | "default";
}

const { entry, size = "default" } = Astro.props;
const { title, summary, tags } = entry.data;
const accent: Accent = entry.data.accent ?? "coral";
const href = `/projects/${entry.id}`;
const year = yearOf(entry.data.publishedAt);
---
<article class="card-quiet overflow-hidden self-start group">
  <a href={href} class="block focus:outline-none">
    <div class="aspect-[5/3] overflow-hidden border-b border-[color:var(--color-edge)] bg-[color:var(--color-surface-muted)]">
      <Media
        id={thumbnailId(entry)}
        alt={`${title} — thumbnail`}
        width={520}
        height={312}
        sizes="(min-width: 768px) 360px, 100vw"
        class="w-full h-full object-cover"
      />
    </div>

    <div class:list={[size === "compact" ? "p-4" : "p-5"]}>
      <div class="flex items-baseline justify-between gap-3">
        <h3 class={`font-display text-xl md:text-2xl leading-tight transition-colors group-hover:text-[color:var(--color-pastel-${accent}-deep)]`}>
          {title}
        </h3>
        <span class="font-hand text-base text-[color:var(--color-ink-muted)] shrink-0">
          {year}
        </span>
      </div>

      <p class="mt-2 text-sm leading-relaxed">{summary}</p>

      {tags?.length ? (
        <ul class="mt-3 flex flex-wrap gap-1.5 list-none p-0">
          {tags.map((tag) => (
            <li class:list={["chip", chipClass(accent)]}>{tag}</li>
          ))}
        </ul>
      ) : null}
    </div>
  </a>
</article>
