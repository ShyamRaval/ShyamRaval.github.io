---
import Media from "./Media.astro";

type Accent = "coral" | "sky" | "mint" | "butter" | "lavender" | "rose";

interface Project {
  slug: string;
  title: string;
  summary: string;
  thumbnail: string;
  tags: string[];
  accent?: Accent;
  year?: string;
}

interface Props {
  project: Project;
  href?: string;
  size?: "compact" | "default";
}

const { project, href, size = "default" } = Astro.props;
const linkHref = href ?? `/projects/${project.slug}`;
const accent: Accent = project.accent ?? "coral";
---
<article class="card-quiet overflow-hidden self-start">
  <a href={linkHref} class="block focus:outline-none">
    <div class="aspect-[5/3] overflow-hidden border-b border-[color:var(--color-edge)] bg-[color:var(--color-surface-muted)]">
      <Media
        id={project.thumbnail}
        alt={`${project.title} — thumbnail`}
        width={520}
        height={312}
        sizes="(min-width: 768px) 360px, 100vw"
        class="w-full h-full object-cover"
      />
    </div>

    <div class:list={[size === "compact" ? "p-4" : "p-5"]}>
      <div class="flex items-baseline justify-between gap-3">
        <h3 class={`font-display text-xl md:text-2xl leading-tight transition-colors group-hover:text-[color:var(--color-pastel-${accent}-deep)]`}>
          {project.title}
        </h3>
        {project.year && (
          <span class="font-hand text-base text-[color:var(--color-ink-muted)] shrink-0">
            {project.year}
          </span>
        )}
      </div>

      <p class="mt-2 text-sm leading-relaxed">{project.summary}</p>

      {project.tags?.length ? (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <li class={`chip chip-${accent}`}>{tag}</li>
          ))}
        </ul>
      ) : null}
    </div>
  </a>
</article>
