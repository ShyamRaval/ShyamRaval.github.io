---
/**
 * Footer — renders as a two-state floating dock at the bottom of the viewport.
 *
 * RESTING (default on pointer devices):
 *   Shows a small textual invitation — "socials — say hello" — mixing display
 *   italic + handwritten Caveat. No icons visible.
 *
 * ACTIVE (hover / focus-within on pointer devices):
 *   The text crossfades into a row of brand-tinted icons.
 *
 * PER-ICON HOVER:
 *   A small floating "business card" appears above the dock — handle in display
 *   italic, one-line handwritten note. Implemented as a CSS-only tooltip.
 *
 * TOUCH DEVICES:
 *   `@media (hover: none) and (pointer: coarse)` in global.css skips the
 *   resting state and shows icons directly. Tapping an icon navigates.
 *
 * Per PLAN.md: no nav, no copy, no copyright. Just contact.
 */
import { site } from "../data/site";

type Brand = "email" | "github" | "linkedin" | "x";

interface DockEntry {
  href: string;
  label: string;
  brand: Brand;
  handle: string;
  note: string;
  external?: boolean;
}

const findSocial = (q: string) =>
  site.socials.find((s) => s.label.toLowerCase().includes(q));

const github = findSocial("github");
const linkedin = findSocial("linkedin");
const x = findSocial("x") ?? findSocial("twitter");

const handleFromHref = (href: string, prefix = "@") => {
  try {
    const url = new URL(href);
    const parts = url.pathname.split("/").filter(Boolean);
    const last = parts[parts.length - 1] ?? "";
    return last ? `${prefix}${last}` : url.hostname;
  } catch {
    return href;
  }
};

const entries: DockEntry[] = [
  {
    href: `mailto:${site.email}`,
    label: "Email",
    brand: "email",
    handle: site.email,
    note: "drop a line",
  },
];

if (github) {
  entries.push({
    href: github.href,
    label: "GitHub",
    brand: "github",
    handle: handleFromHref(github.href),
    note: "code & weekend things",
    external: true,
  });
}

if (linkedin) {
  entries.push({
    href: linkedin.href,
    label: "LinkedIn",
    brand: "linkedin",
    handle: handleFromHref(linkedin.href, "in/"),
    note: "the resume version",
    external: true,
  });
}

if (x) {
  entries.push({
    href: x.href,
    label: "X",
    brand: "x",
    handle: handleFromHref(x.href),
    note: "occasional ramblings",
    external: true,
  });
}
---
<aside class="dock-shell" transition:persist transition:name="contact-dock" aria-label="Contact dock">
  {/* RESTING STATE — visible by default on pointer devices */}
  <span class="dock-resting" aria-hidden="true">
    <span class="font-display italic text-[0.95rem] text-[color:var(--color-ink)]">socials</span>
    <span class="font-hand text-[1.05rem] ink-coral leading-none">— say hello</span>
  </span>

  {/* ACTIVE STATE — icons crossfade in on hover / focus / touch.
       On touch devices, JS below tracks finger position so the floating
       business card follows whichever icon is currently under the finger. */}
  <span class="dock-icons">
    {entries.map((entry) => (
      <a
        href={entry.href}
        class="dock-icon"
        data-brand={entry.brand}
        aria-label={`${entry.label} — ${entry.handle}`}
        target={entry.external ? "_blank" : undefined}
        rel={entry.external ? "noreferrer noopener" : undefined}
      >
        <span class="dock-card" aria-hidden="true">
          <span class="dock-card-handle">{entry.handle}</span>
          <span class="dock-card-note">{entry.note}</span>
        </span>

        {entry.brand === "email" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="m3 7 9 6 9-6"/>
          </svg>
        )}
        {entry.brand === "github" && (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.66.5 12.02c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.13c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.3-.51-1.47.11-3.07 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.6.23 2.77.11 3.07.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.2.66.79.55C20.22 21.4 23.5 17.09 23.5 12.02 23.5 5.66 18.35.5 12 .5Z"/>
          </svg>
        )}
        {entry.brand === "linkedin" && (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .78 0 1.74v20.51C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0Z"/>
          </svg>
        )}
        {entry.brand === "x" && (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2H21.5l-7.59 8.68L23 22h-6.808l-5.34-6.97L4.74 22H1.48l8.13-9.29L1 2h6.91l4.83 6.39L18.244 2Zm-1.193 18.05h1.82L7.04 3.86H5.13l11.92 16.19Z"/>
          </svg>
        )}
      </a>
    ))}
  </span>
</aside>

<script>
  /**
   * Touch-drag tracking for the dock.
   *
   * On touch devices, the resting label is hidden and icons are always
   * visible. When the user touches an icon and slides across the dock:
   *   - the dock expands (`.is-dragging`) to fill much of the viewport,
   *     giving them a much larger slide-target.
   *   - the floating "business card" above the dock follows the finger,
   *     always reflecting whichever icon is currently under the touch
   *     point.
   *
   * Implementation:
   *   - touchstart on an icon: capture drag, mark that icon `.is-active`,
   *     schedule the shell to enter the expanded state after a tiny delay
   *     so a quick tap doesn't trigger the grow animation.
   *   - touchmove on document: cancel the delay (clearly a drag now), grow
   *     immediately, re-evaluate which icon is under the finger via
   *     `elementFromPoint`, swap the active class.
   *   - touchend: navigate to whichever icon the finger landed on, shrink.
   *   - touchcancel / finger off all icons: just clear the active state.
   *
   * Touches that begin in the dock's padding (not on an icon) are left
   * alone so they can't accidentally block page scroll.
   */
  const HOLD_GROW_DELAY = 90;

  const initDock = () => {
    const shell = document.querySelector<HTMLElement>(".dock-shell");
    if (!shell) return;
    if (shell.dataset.dockTouchInit === "1") return;
    if (!matchMedia("(hover: none) and (pointer: coarse)").matches) return;
    shell.dataset.dockTouchInit = "1";

    let activeIcon: HTMLElement | null = null;
    let dragging = false;
    let growTimer: ReturnType<typeof setTimeout> | null = null;

    const findIconAt = (x: number, y: number): HTMLElement | null => {
      const el = document.elementFromPoint(x, y);
      if (!el) return null;
      return (el as Element).closest<HTMLElement>(".dock-icon");
    };

    const setActive = (icon: HTMLElement | null) => {
      if (activeIcon && activeIcon !== icon) {
        activeIcon.classList.remove("is-active");
      }
      if (icon && icon !== activeIcon) {
        icon.classList.add("is-active");
      }
      activeIcon = icon;
    };

    const grow = () => {
      if (growTimer) {
        clearTimeout(growTimer);
        growTimer = null;
      }
      shell.classList.add("is-dragging");
    };

    const clear = () => {
      if (growTimer) {
        clearTimeout(growTimer);
        growTimer = null;
      }
      if (activeIcon) activeIcon.classList.remove("is-active");
      activeIcon = null;
      dragging = false;
      shell.classList.remove("is-dragging");
    };

    shell.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        const t = e.touches[0];
        if (!t) return;
        const icon = findIconAt(t.clientX, t.clientY);
        if (!icon) return; // touch began on dock padding — let it scroll
        e.preventDefault();
        dragging = true;
        setActive(icon);
        // Quick taps shouldn't trigger the grow animation; only do it
        // once the finger has been down long enough to look like a hold.
        growTimer = setTimeout(grow, HOLD_GROW_DELAY);
      },
      { passive: false }
    );

    document.addEventListener(
      "touchmove",
      (e: TouchEvent) => {
        if (!dragging) return;
        e.preventDefault();
        const t = e.touches[0];
        if (!t) return;
        // Any movement is clearly a drag — promote the dock to its
        // expanded form immediately for the bigger slide-target.
        if (!shell.classList.contains("is-dragging")) grow();
        const icon = findIconAt(t.clientX, t.clientY);
        setActive(icon);
      },
      { passive: false }
    );

    const finish = () => {
      if (!dragging) return;
      const target = activeIcon;
      clear();
      if (target && target.getAttribute("href")) {
        // Trigger the link's native click so view transitions still apply
        // for internal navigation, and new-tab opens for external links.
        target.click();
      }
    };

    document.addEventListener("touchend", finish);
    document.addEventListener("touchcancel", clear);
  };

  initDock();
  document.addEventListener("astro:page-load", initDock);
</script>
