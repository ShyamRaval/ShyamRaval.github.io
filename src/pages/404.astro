---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Lost" description="That page wandered off." noIndex>
  <section class="container-page section-lg text-center">
    <p class="font-hand text-3xl ink-coral">well, this is awkward</p>
    <h1 class="mt-2 text-gradient inline-block">404</h1>
    <p class="mx-auto mt-4 max-w-md text-base md:text-lg text-[color:var(--color-ink-soft)] leading-relaxed">
      This page wandered off somewhere. It happens to the best of us. The
      good news is everything worth finding is one short trip away.
    </p>
    <p class="mt-6 font-hand text-2xl">
      use the navigator at the bottom, or
      <a href="/" class="link-underline ink-lavender">head back home</a>.
    </p>
  </section>
</BaseLayout>
